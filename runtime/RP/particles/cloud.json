{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "ordertocook:cloud",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.count = variable.count ?? 1; variable.spread_x = variable.spread_x ?? 0; variable.spread_y = variable.spread_y ?? 0; variable.spread_z = variable.spread_z ?? 0; variable.speed = variable.speed ?? 0;"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "variable.count"
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          "variable.spread_x * (math.sqrt(-2 * math.ln(math.max(0.000001, math.random(0, 1)))) * math.cos(360 * math.random(0, 1)))",
          "variable.spread_y * (math.sqrt(-2 * math.ln(math.max(0.000001, math.random(0, 1)))) * math.cos(360 * math.random(0, 1)))",
          "variable.spread_z * (math.sqrt(-2 * math.ln(math.max(0.000001, math.random(0, 1)))) * math.cos(360 * math.random(0, 1)))"
        ]
      },
      "minecraft:particle_initial_speed": [
        "variable.speed * (math.sqrt(-2 * math.ln(math.max(0.000001, math.random(0, 1)))) * math.cos(360 * math.random(0, 1)))",
        "variable.speed * (math.sqrt(-2 * math.ln(math.max(0.000001, math.random(0, 1)))) * math.cos(360 * math.random(0, 1)))",
        "variable.speed * (math.sqrt(-2 * math.ln(math.max(0.000001, math.random(0, 1)))) * math.cos(360 * math.random(0, 1)))"
      ],
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.6, 1.4)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.1,
          0
        ],
        "linear_drag_coefficient": 0.49
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.15 + variable.particle_random_1 * 0.15",
          "0.15 + variable.particle_random_1 * 0.15"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ],
          "flipbook": {
            "base_UV": [
              56,
              0
            ],
            "size_UV": [
              8,
              8
            ],
            "step_UV": [
              -8,
              0
            ],
            "frames_per_second": 8,
            "max_frame": 8,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "1 - variable.particle_age / variable.particle_lifetime"
        ]
